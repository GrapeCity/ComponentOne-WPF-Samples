<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>CustomTypeDescriptor.4</AssemblyName>
    <RootNamespace>CustomTypeDescriptor</RootNamespace>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DefineConstants>TRACE;DEBUG;WPF</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DefineConstants>TRACE;WPF</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="C1.Xaml.WPF">
      <Version>4.6.20261.8</Version>
    </PackageReference>
    <PackageReference Include="C1.Xaml.WPF.FlexGrid">
      <Version>4.6.20261.8</Version>
    </PackageReference>
    <PackageReference Include="C1.Zip" Version="10.0.20261.*" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\data.zip" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\clear.png" />
    <Resource Include="Resources\search.png" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include=".sa3licx" />
  </ItemGroup>
</Project>