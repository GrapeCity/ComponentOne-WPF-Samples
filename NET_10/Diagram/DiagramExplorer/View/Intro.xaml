<UserControl x:Class="DiagramExplorer.View.Intro"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DiagramExplorer.View"
             xmlns:c1="http://schemas.componentone.com/winfx/2006/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="c1:Node">
            <Setter Property="Shape" Value="RoundedRectangle" />
        </Style>
        <Style TargetType="c1:Edge">
            <Setter Property="TargetArrow" Value="Normal" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <c1:FlexDiagram x:Name="diagram" LegendPosition="None">
            <c1:Node Title="Start" ID="start" Shape="Rectangle" LegendItem="Start" />
            <c1:Node Title="Decision" ID="decision" Shape="Diamond" LegendItem="Decision"/>
            <c1:Node Title="Option A" ID="optionA" LegendItem="Option"/>
            <c1:Node Title="Option B" ID="optionB" LegendItem="Option"/>
            <c1:Node Title="Option C" ID="optionC" LegendItem="Option"/>

            <c1:FlexDiagram.Edges>
                <c1:Edge SourceID="start" TargetID="decision" TargetArrow="Normal" />
                <c1:Edge SourceID="decision" TargetID="optionA" TargetArrow="Normal" />
                <c1:Edge SourceID="decision" TargetID="optionB" TargetArrow="Normal" />
                <c1:Edge SourceID="decision" TargetID="optionC" TargetArrow="Normal" />
            </c1:FlexDiagram.Edges>
        </c1:FlexDiagram>
    </Grid>
</UserControl>
