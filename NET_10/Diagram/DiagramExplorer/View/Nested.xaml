<UserControl x:Class="DiagramExplorer.View.Nested"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DiagramExplorer.View"
             xmlns:c1="http://schemas.componentone.com/winfx/2006/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="c1:Node">
            <Setter Property="Shape" Value="RoundedRectangle" />
        </Style>
        <Style TargetType="c1:Edge">
            <Setter Property="TargetArrow" Value="Normal" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <c1:FlexDiagram x:Name="diagram" LegendPosition="None">
            <c1:FlexDiagram.NodeTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="8">
                        <StackPanel>
                            <TextBlock Text="{Binding}" FontSize="16" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ID}" Value="system">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Expander Header="{Binding Title}">
                                <Expander.Style>
                                    <Style TargetType="Expander">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ID}" Value="system">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Expander.Style>

                                <c1:FlexDiagram Loaded="FlexDiagram_Loaded" ScaleMode="ScaleToFit" InteractionMode="None" Width="360" Height="360">
                                </c1:FlexDiagram>
                            </Expander>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </c1:FlexDiagram.NodeTemplate>            
            <c1:Node Title="System" ID="system" />
            <c1:Node Title="Frontend" ID="frontend" />
            <c1:Node Title="Backend" ID="backend" />
            <c1:Node Title="Data Platform" ID="data" />
            <c1:FlexDiagram.Edges>
                <c1:Edge SourceID="system" TargetID="frontend" />
                <c1:Edge SourceID="system" TargetID="backend" />
                <c1:Edge SourceID="system" TargetID="data" />
            </c1:FlexDiagram.Edges>
        </c1:FlexDiagram>
    </Grid>
</UserControl>
