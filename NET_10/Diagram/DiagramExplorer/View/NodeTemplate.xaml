<UserControl x:Class="DiagramExplorer.View.NodeTemplate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DiagramExplorer.View"
             xmlns:c1="http://schemas.componentone.com/winfx/2006/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="booleanToVisiblity" />
        <Style TargetType="ListBox">
            <Setter Property="MaxHeight" Value="120" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <c1:FlexDiagram x:Name="diagram" Direction="TopBottom" ScaleMode="ScaleToFit" >
            <c1:FlexDiagram.NodeTemplate>
                <DataTemplate DataType="c1:Node">
                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5">
                        <StackPanel Margin="8">
                            <TextBlock Text="{Binding}" FontSize="12" FontWeight="Bold" />
                            <Expander Header="Properties" Visibility="{Binding HasProperties, Converter={StaticResource booleanToVisiblity}}">
                                <ListBox ItemsSource="{Binding Properties}" />
                            </Expander>
                            <Expander Header="Events" Visibility="{Binding HasEvents, Converter={StaticResource booleanToVisiblity}}">
                                <ListBox ItemsSource="{Binding Events}" />
                            </Expander>
                            <Expander Header="Methods" Visibility="{Binding HasMethods, Converter={StaticResource booleanToVisiblity}}">
                                <ListBox ItemsSource="{Binding Methods}" />
                            </Expander>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </c1:FlexDiagram.NodeTemplate>
        </c1:FlexDiagram>
    </Grid>
</UserControl>
