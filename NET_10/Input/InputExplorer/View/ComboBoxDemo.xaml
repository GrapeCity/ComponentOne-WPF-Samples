<UserControl x:Class="InputExplorer.ComboBoxDemo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:c1="http://schemas.componentone.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:InputExplorer"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <local:EmployeeTypeConverter x:Key="EmployeeConverter" />

        <local:ItemStyleSelector x:Key="StyleSelector">
            <local:ItemStyleSelector.Resources>
                <ResourceDictionary>
                    <Style x:Key="Common" TargetType="{x:Type ContentControl}">
                        <Setter Property="Background" Value="AliceBlue"/>
                        <Setter Property="Foreground" Value="BlueViolet"/>
                    </Style>
                    <Style x:Key="Alternate" TargetType="{x:Type ContentControl}">
                        <Setter Property="Background" Value="LightPink"/>
                        <Setter Property="Foreground" Value="IndianRed"/>
                    </Style>
                </ResourceDictionary>
            </local:ItemStyleSelector.Resources>
        </local:ItemStyleSelector>

        <local:ItemTemplateSelector x:Key="TemplateSelector" />
        <DataTemplate x:Key="Template1">
            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="CornflowerBlue" VerticalAlignment="Center"/>
        </DataTemplate>
        <DataTemplate x:Key="Template2">
            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="IndianRed" VerticalAlignment="Center"/>
        </DataTemplate>
        <Style x:Key="ComboBoxStyle" TargetType="c1:C1ComboBox">
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="Margin" Value="10 0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <c1:C1WrapPanel>
        <StackPanel>
            <Label Content="ItemContainerStyle:" Style="{StaticResource LabelStyle}"/>
            <c1:C1ComboBox AutoComplete="True" Style="{StaticResource ComboBoxStyle}">
                <c1:C1ComboBox.ItemContainerStyle>
                    <Style TargetType="ContentControl">
                        <Setter Property="Background" Value="AliceBlue"/>
                        <Setter Property="Foreground" Value="BlueViolet"/>
                    </Style>
                </c1:C1ComboBox.ItemContainerStyle>
                <c1:ComboBoxItem Content="item 1"/>
                <c1:ComboBoxItem Content="item 2"/>
                <c1:ComboBoxItem Content="item 3"/>
                <c1:ComboBoxItem Content="item 4"/>
                <c1:ComboBoxItem Content="item 5"/>
            </c1:C1ComboBox>
        </StackPanel>

        <StackPanel>
            <Label Content="ItemContainerStyleSelector:" Style="{StaticResource LabelStyle}"/>
            <c1:C1ComboBox Style="{StaticResource ComboBoxStyle}"
               ItemContainerStyleSelector="{StaticResource StyleSelector}">
                <c1:ComboBoxItem Content="item 1"/>
                <c1:ComboBoxItem Content="item 2"/>
                <c1:ComboBoxItem Content="item 3"/>
                <c1:ComboBoxItem Content="item 4"/>
                <c1:ComboBoxItem Content="item 5"/>
            </c1:C1ComboBox>
        </StackPanel>

        <StackPanel>
            <Label Content="ItemTemplate:" Style="{StaticResource LabelStyle}"/>
            <c1:C1ComboBox Name="ComboBox1" AutoComplete="False" Style="{StaticResource ComboBoxStyle}">
                <c1:C1ComboBox.ItemTemplate>
                    <DataTemplate>
                        <c1:C1LinePanel Spacing="1">
                            <Image Source="{Binding FlagUrl}" Width="20" Height="16"/>
                            <TextBlock Text="{Binding Name}" Margin="2 0 0 0" VerticalAlignment="Center" Grid.Column="1"/>
                        </c1:C1LinePanel>
                    </DataTemplate>
                </c1:C1ComboBox.ItemTemplate>
            </c1:C1ComboBox>
        </StackPanel>

        <StackPanel>
            <Label Content="ItemTemplateSelector:" Style="{StaticResource LabelStyle}"/>
            <c1:C1ComboBox Name="ComboBox2" 
               Style="{StaticResource ComboBoxStyle}"
               ItemConverter="{StaticResource EmployeeConverter}"
               ItemTemplateSelector ="{StaticResource TemplateSelector}"/>
        </StackPanel>

        <StackPanel>
            <Label Content="Grouped:" Style="{StaticResource LabelStyle}"/>
            <c1:C1ComboBox Name="GroupedComboBox" Style="{StaticResource ComboBoxStyle}"/>
        </StackPanel>
    </c1:C1WrapPanel>
</UserControl>
