<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:res="clr-namespace:FlexGridExplorer.Resources"
             xmlns:c1="http://schemas.componentone.com/winfx/2006/xaml" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors" 
             x:Class="FlexGridExplorer.TransposedGrid"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <c1:C1TextBox x:Name="filter" Margin="4" Placeholder="{x:Static res:AppResources.FilterPlaceholderText}" HorizontalAlignment="Left" MinWidth="250"/>
        <c1:FlexGrid x:Name="grid" Grid.Row="1">
            <i:Interaction.Behaviors>
                <c1:TransposedGridBehavior/>
                <c1:FullTextFilterBehavior FilterEntry="{Binding Source={x:Reference filter}}" />
            </i:Interaction.Behaviors>
        </c1:FlexGrid>
    </Grid>
</UserControl>
