<Window x:Class="LocaleDateGrid.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LocaleDateGrid"
        xmlns:c1="http://schemas.componentone.com/winfx/2006/xaml"
        mc:Ignorable="d"
        Title="{x:Static local:AppResources.AppName}" Height="450" Width="800">
    <Grid>
        <c1:FlexGrid x:Name="grid" AutoGenerateColumns="False" SelectionMode="Cell">
            <c1:FlexGrid.Columns>
                <c1:GridColumn Binding="Label" Header=" " Width="Auto"/>
                <c1:GridDateTimeColumn Binding="DateTime" Mode="Time" Header="{x:Static local:AppResources.LocalLabel}" Format="HH:mm:ss"/>
                <c1:GridDateTimeColumn Binding="DateTime" Offset="9:0:0" Mode="Time" Header="{x:Static local:AppResources.TokioLabel}" Format="HH:mm:ss" Width="*"/>
                <c1:GridDateTimeColumn Binding="DateTime" Offset="4:0:0" Mode="Time" Header="{x:Static local:AppResources.DubaiLabel}" Format="HH:mm:ss" Width="*"/>
                <c1:GridDateTimeColumn Binding="DateTime" Offset="0:0:0" Mode="Time" Header="{x:Static local:AppResources.LondonLabel}" Format="HH:mm:ss" Width="*"/>
                <c1:GridDateTimeColumn Binding="DateTime" Offset="-5:0:0" Mode="Time" Header="{x:Static local:AppResources.NewYorkLabel}" Format="HH:mm:ss" Width="*"/>
            </c1:FlexGrid.Columns>
        </c1:FlexGrid>
    </Grid>
</Window>
