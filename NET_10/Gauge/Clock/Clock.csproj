<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>C1-ball.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove=".sa3licx" />
    <None Remove="Icons\dot.svg" />
    <None Remove="Icons\hours.svg" />
    <None Remove="Icons\minutes.svg" />
    <None Remove="Icons\seconds.svg" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="C1-ball.ico" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include=".sa3licx" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Icons\dot.svg" />
    <Resource Include="Icons\hours.svg" />
    <Resource Include="Icons\minutes.svg" />
    <Resource Include="Icons\seconds.svg" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="C1.WPF.Gauge">
      <Version>10.0.20261.47</Version>
    </PackageReference>
  </ItemGroup>
</Project>